# Environment Configuration for TradeX Backend
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave empty to use embedded in-memory MongoDB for zero-config evaluation)
MONGODB_URI=mongodb://127.0.0.1:27017/tradex

# JWT Secret Key
JWT_SECRET=tradex_super_secret_jwt_key_2026_dev_only
JWT_EXPIRES_IN=7d

# Initial Virtual Cash for new traders (in INR)
INITIAL_VIRTUAL_BALANCE=100000

# Client URL for CORS
CLIENT_URL=http://localhost:5173
