# Environment Configuration for TradeX Backend
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# 1. In MongoDB Atlas dashboard: Cluster -> Connect -> Drivers -> Node.js
# 2. Copy connection string and replace <username> and <password> with your Atlas Database User credentials
# 3. The database name 'tradex' is specified in the path and enforced by Mongoose
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tradex?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=tradex_super_secret_jwt_key_2026_dev_only
JWT_EXPIRES_IN=7d

# Initial Virtual Cash for new traders (in INR)
INITIAL_VIRTUAL_BALANCE=100000

# Client URL for CORS
CLIENT_URL=http://localhost:5173
